# Copy this file to .env (never commit .env) and fill in the values below.
# Generate strong 32-byte hex secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# PostgreSQL database superuser username
POSTGRES_USER=codecollab

# PostgreSQL database user password (change it for anything beyond local demos)
POSTGRES_PASSWORD=codecollab_dev_password

# PostgreSQL default database name
POSTGRES_DB=codecollab

# REQUIRED. HMAC secret (at least 32 characters) for signing short-lived JWT access tokens. Leave no placeholder here: docker compose refuses to start while this is empty.
JWT_ACCESS_SECRET=

# REQUIRED. HMAC secret (at least 32 characters) for signing long-lived JWT refresh tokens. Must differ from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=

# Optional HMAC secret (at least 32 characters) for signing OAuth state nonces. When empty and LOCAL_DEMO=true it is derived from JWT_ACCESS_SECRET.
OAUTH_STATE_SECRET=

# Local demo mode for docker compose. It only allows a derived OAUTH_STATE_SECRET and cookie transport without Secure cookies. It never relaxes JWT secret checks. Set to false (and provide OAUTH_STATE_SECRET) for anything that is not a local evaluation.
LOCAL_DEMO=true

# Authentication token delivery mechanism: bearer (header) or cookie (httpOnly cookies)
AUTH_TRANSPORT=bearer

# Set to true when serving over HTTPS with cookie transport mode; false for local HTTP development
COOKIE_SECURE=false

# Optional secret for authenticating detailed health check probes
HEALTH_CHECK_SECRET=

# Optional GitHub OAuth App client ID; leave empty to disable GitHub sign-in
GITHUB_CLIENT_ID=

# Optional GitHub OAuth App client secret; leave empty to disable GitHub sign-in. Never commit a real value.
GITHUB_CLIENT_SECRET=

# GitHub OAuth redirect authorization callback URL (must match the callback registered on the GitHub OAuth App)
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# Mail service provider: console or smtp
MAIL_PROVIDER=console
