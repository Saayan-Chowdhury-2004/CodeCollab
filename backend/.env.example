NODE_ENV="development"
PORT="4000"
# Set to the number of reverse proxies that overwrite X-Forwarded-For; 0 when the backend is directly reachable
TRUST_PROXY_HOPS="0"
APP_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:4000,http://localhost:5173,http://localhost:3000"
OAUTH_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:5173,http://localhost:3000"
CSP_FRAME_ANCESTORS="'none'"
CSP_CONNECT_SRC="'self' ws: wss:"
CSP_SCRIPT_SRC="'self'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
AUTH_TRANSPORT="bearer"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
LOCAL_DEMO="false"
JWT_ACCESS_SECRET="replace-with-at-least-32-char-access-secret"
JWT_ACCESS_SECRET_PREVIOUS=""
JWT_REFRESH_SECRET="replace-with-at-least-32-char-refresh-secret"
JWT_REFRESH_SECRET_PREVIOUS=""
OAUTH_STATE_SECRET=""
HEALTH_CHECK_SECRET=""
JWT_ACCESS_EXPIRES_IN_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="7"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"
MAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@codecollab.dev"
LOG_LEVEL="info"
DATABASE_URL="postgresql://codecollab:codecollab_dev_password@localhost:5432/codecollab"
DB_SSL="false"
DB_SSL_CA=""
AUTH_RATE_LIMIT_MAX=""
API_RATE_LIMIT_MAX=""
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="postgres"
SQL_DB_NAME="codecollab"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="postgres"
